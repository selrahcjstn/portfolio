---
import PageLayout from '../layout/PageLayout.astro';
import PageBackLink from '../components/ui/PageBackLink.astro';
import ProjectList from '../components/ui/ProjectList.astro';
import { profile, projects } from '../data/portfolio';

const description = 'Web, mobile, and game projects where I’ve turned ideas and problems into working software.';
---

<PageLayout title={`Projects · ${profile.name}`} description={description}>
  <PageBackLink href="/#projects" />
  <header class="projects-intro">
    <p class="projects-eyebrow">PROJECTS</p>
    <h1>Things I've built.</h1>
    <p class="projects-summary">{description}</p>
  </header>
  <ProjectList projects={projects} fullWidth />
</PageLayout>

<style>
  .projects-intro { max-width: 780px; }
  .projects-eyebrow { color: var(--color-foreground-secondary); font-family: 'Geist Mono', monospace; font-size: 12px; font-weight: 500; line-height: 20px; letter-spacing: 0.06em; }
  h1 { margin-top: 18px; color: var(--color-foreground-primary); font-size: clamp(32px, 4.2vw, 52px); font-weight: 600; line-height: 1.12; letter-spacing: -0.045em; }
  .projects-summary { max-width: 680px; margin-top: 22px; color: var(--color-foreground-secondary); font-size: 17px; line-height: 1.75; }
  @media (max-width: 700px) {
    .projects-summary { font-size: 16px; }
  }
</style>
