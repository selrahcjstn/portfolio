---
import { deviconClasses } from '../../lib/devicons';

interface Props {
  tags: string[];
  label: string;
}

const { tags, label } = Astro.props;
---

<ul class="tag-list" aria-label={label}>
  {tags.map((tag) => (
    <li>
      <i class:list={['devicon', deviconClasses[tag]]} aria-hidden="true"></i>
      <span>{tag}</span>
    </li>
  ))}
</ul>
