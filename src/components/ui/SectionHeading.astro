---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<header class="section-heading">
  <p class="section-label">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="section-description">{description}</p>}
</header>
