---
import { ArrowLeftIcon } from '@lucide/astro';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="page-back-link" href={href}>
  <ArrowLeftIcon size={15} strokeWidth={1.7} aria-hidden="true" />
  <span>Back to portfolio</span>
</a>

<style>
  .page-back-link { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 38px; color: var(--color-foreground-secondary); font-family: 'Geist Mono', monospace; font-size: 11px; font-weight: 500; line-height: 20px; transition: color 220ms ease; }
  .page-back-link :global(svg) { flex: 0 0 auto; transition: transform 220ms cubic-bezier(0.2, 0.75, 0.25, 1); }
  .page-back-link span { position: relative; }
  .page-back-link span::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1px; background: currentColor; content: ''; transform: scaleX(0); transform-origin: left; transition: transform 220ms ease; }
  .page-back-link:hover, .page-back-link:focus-visible { color: var(--color-foreground-primary); }
  .page-back-link:hover :global(svg), .page-back-link:focus-visible :global(svg) { transform: translateX(-3px); }
  .page-back-link:hover span::after, .page-back-link:focus-visible span::after { transform: scaleX(1); }
  .page-back-link:focus-visible { outline: 2px solid var(--color-foreground-primary); outline-offset: 4px; }
  @media (max-width: 700px) {
    .page-back-link { margin-bottom: 30px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-back-link, .page-back-link :global(svg), .page-back-link span::after { transition: none; }
    .page-back-link:hover :global(svg), .page-back-link:focus-visible :global(svg) { transform: none; }
  }
</style>
