---
import { BriefcaseBusinessIcon, CameraIcon, UsersRoundIcon } from '@lucide/astro';
import SectionNavigation from './SectionNavigation.astro';
import { profile } from '../../data/portfolio';
---

<aside class="profile-panel" aria-labelledby="profile-name">
  <div class="profile-copy">
    <h1 id="profile-name">{profile.name}</h1>
    <p class="role">{profile.role}</p>
    <p class="tagline">{profile.tagline}</p>
  </div>

  <SectionNavigation />

  <nav class="social-links" aria-label="Social links">
    <a href="#projects" aria-label="GitHub"><i class="devicon devicon-github-plain" aria-hidden="true"></i></a>
    <a href="#contact" aria-label="Instagram"><CameraIcon size={22} strokeWidth={1.7} aria-hidden="true" /></a>
    <a href="#contact" aria-label="LinkedIn"><BriefcaseBusinessIcon size={22} strokeWidth={1.7} aria-hidden="true" /></a>
    <a href="#contact" aria-label="Facebook"><UsersRoundIcon size={22} strokeWidth={1.7} aria-hidden="true" /></a>
  </nav>
</aside>
