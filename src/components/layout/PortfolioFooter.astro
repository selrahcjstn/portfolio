---
import { ArrowUpRightIcon } from '@lucide/astro';
import { email, profile, socialLinks } from '../../data/portfolio';

const [emailName, emailDomain] = email.split('@');
---

<footer class="site-footer" aria-label="Portfolio footer">
  <div class="footer-invitation">
    <p class="footer-label">LET'S WORK TOGETHER</p>
    <a class="footer-email" href={`mailto:${email}`} aria-label={`Email Charles at ${email}`}>
      <span>{emailName}</span><wbr /><span>@{emailDomain}</span>
    </a>
    <nav class="footer-links" aria-label="Footer links">
      <a href={socialLinks.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile (opens in a new tab)">GitHub</a>
      {socialLinks.linkedin
        ? <a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile (opens in a new tab)">LinkedIn</a>
        : <span aria-disabled="true" title="LinkedIn link not set">LinkedIn</span>}
      <a href={socialLinks.resume || '#contact'} target={socialLinks.resume ? '_blank' : undefined} rel={socialLinks.resume ? 'noopener noreferrer' : undefined} aria-label={socialLinks.resume ? 'View resume (opens in a new tab)' : 'Contact Charles to request a resume'}>
        Resume <ArrowUpRightIcon size={14} strokeWidth={1.7} aria-hidden="true" />
      </a>
    </nav>
  </div>
  <div class="footer-meta">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>Built with Astro</span>
  </div>
</footer>

<style>
  .site-footer { display: flex; min-height: clamp(380px, 56svh, 560px); flex-direction: column; padding: 24px clamp(24px, 4vw, 64px) 32px; border-top: 1px solid var(--color-border-default); background: var(--color-background-pure); color: var(--color-foreground-primary); }
  .footer-invitation { display: flex; flex: 1; min-width: 0; align-items: center; justify-content: center; flex-direction: column; padding-block: clamp(48px, 7svh, 88px); text-align: center; }
  .footer-label { margin: 0 0 18px; color: var(--color-foreground-secondary); font-family: 'Geist Mono', monospace; font-size: 11px; font-weight: 500; line-height: 18px; letter-spacing: 0.1em; }
  .footer-email { max-width: 100%; font-size: clamp(28px, 4.4vw, 88px); font-weight: 600; line-height: 1.12; letter-spacing: -0.055em; text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 0.16em; transition: text-decoration-color 220ms ease; }
  .footer-email span { white-space: nowrap; }
  .footer-email:hover, .footer-email:focus-visible { text-decoration-color: currentColor; }
  .footer-links { display: flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: 24px; margin-top: 24px; color: var(--color-foreground-secondary); font-family: 'Geist Mono', monospace; font-size: 12px; line-height: 20px; }
  .footer-links a { display: inline-flex; align-items: center; gap: 4px; transition: color 180ms ease; }
  .footer-links a:hover { color: var(--color-foreground-primary); }
  .footer-links a:hover svg { transform: translate(2px, -2px); }
  .footer-links svg { transition: transform 180ms ease; }
  .footer-links [aria-disabled] { color: var(--color-foreground-muted); }
  a:focus-visible { outline: 2px solid var(--color-foreground-primary); outline-offset: 6px; }
  .footer-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; padding-top: 24px; border-top: 1px solid var(--color-border-default); color: var(--color-foreground-muted); font-family: 'Geist Mono', monospace; font-size: 11px; line-height: 18px; }
  @media (max-width: 560px) {
    .site-footer { min-height: clamp(340px, 58svh, 460px); padding: 20px 20px 28px; }
    .footer-email { font-size: clamp(20px, 6vw, 32px); line-height: 1.22; }
    .footer-email span { display: block; }
    .footer-label { margin-bottom: 14px; font-size: 10px; }
    .footer-links { gap: 20px; margin-top: 18px; font-size: 11px; }
    .footer-meta { justify-content: space-between; text-align: left; font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-email, .footer-links a, .footer-links svg { transition: none; }
  }
</style>
