---
import { ArrowUpRightIcon } from '@lucide/astro';
import TechnologyTags from '../components/ui/TechnologyTags.astro';
import { education } from '../data/portfolio';
---

<section class="education-section" id="education" aria-labelledby="education-heading">
  <h2 class="section-label" id="education-heading">02. EDUCATION</h2>
  <div class="education-list">
    {education.map((item) => (
      <article class="education-item">
        <p class="period">{item.period}</p>
        <div class="education-details">
          <h3>{item.title}<ArrowUpRightIcon size={16} strokeWidth={1.6} aria-hidden="true" /></h3>
          <p>{item.description}</p>
          <TechnologyTags tags={item.tags} label={`${item.title} technologies`} />
        </div>
      </article>
    ))}
  </div>
  <a class="text-link" href="#contact"><span>View My Resume</span><ArrowUpRightIcon size={16} strokeWidth={1.6} aria-hidden="true" /></a>
</section>
